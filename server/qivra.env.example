# Copy to server/qivra.env (git-ignored) and fill in. Read by `python -m qivra serve`.
# Paired phones then use this provider through the server: the key stays on this machine
# and is never sent to phones, put in QR codes, synced or logged.
# Hosted providers must use https. Real environment variables override this file.
QIVRA_AI_BASE_URL=https://api.groq.com/openai/v1
QIVRA_AI_API_KEY=
QIVRA_AI_MODEL=openai/gpt-oss-120b
# Optional; enables semantic search (Groq has no embedding models; Mistral: mistral-embed).
QIVRA_AI_EMBEDDING_MODEL=
