# ────────────────────────────────────────────────────────────────────────────────
# SuperBrain Environment Configuration Template
# ────────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control
# ────────────────────────────────────────────────────────────────────────────────

# ──── Application Settings ────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ──── Server Configuration ────
# Qivra: bind is controlled by `python -m qivra serve [--lan]` (loopback by default).
HOST=127.0.0.1
PORT=5000
WORKERS=4
API_PORT=5000

# ──── Database Configuration ────
DATABASE_PATH=superbrain.db
DATABASE_TIMEOUT=30

# ──── AI Provider API Keys ────
# Get these from the respective provider accounts
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ──── Whisper Configuration ────
# Options: tiny, base, small, medium, large
WHISPER_MODEL=base
WHISPER_USE_CLOUD=true

# ──── Instagram Credentials ────
# Use a bot account or app-specific credentials, NOT your personal account
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# ──── File Upload Configuration ────
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=static/uploads
TEMP_DIR=temp

# ──── Request Timeout Settings ────
REQUEST_TIMEOUT=60
ANALYSIS_TIMEOUT=120
MAX_RETRIES=3
RETRY_DELAY=5

# ──── Feature Flags ────
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true
ENABLE_API_DOCS=false

# ────────────────────────────────────────────────────────────────────────────────
# NOTE: Update only the values you need
# Leave blank if optional or use defaults
# ────────────────────────────────────────────────────────────────────────────────

# ──── Qivra local server ────
# Enable LAN pairing without the --lan flag (not recommended; prefer the flag)
QIVRA_LAN=0
# One-time pairing code lifetime in seconds
QIVRA_PAIRING_TTL_S=300
# Where Qivra stores uploads (defaults to server/data)
QIVRA_DATA_DIR=
# Max media upload size in bytes (default 200 MB)
QIVRA_UPLOAD_MAX_BYTES=209715200
# Allow the legacy SuperBrain 8-char token from non-loopback clients (insecure; default 0)
QIVRA_ALLOW_LEGACY_LAN_TOKEN=0
# Browser origins allowed to call the API (comma-separated, e.g. chrome-extension://<id>); empty = none
ALLOWED_ORIGINS=
