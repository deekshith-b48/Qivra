# Qivra Android app — there are NO build-time secrets.
# The server URL and device credential are set in the app by QR pairing
# (credential stored in Android Keystore-backed storage).
# AI provider keys are entered in the app (Settings → AI models), never bundled.

# Optional, only for building on a machine whose default NDK is missing:
# QIVRA_NDK_VERSION=28.2.13676358
# QIVRA_ANDROID_ABIS=arm64-v8a,x86_64
